# Leave demo enabled until Yahoo has approved access and you authorize your account.
YAHOO_DEMO=true
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must exactly match the callback registered with Yahoo.
YAHOO_REDIRECT_URI=http://127.0.0.1:8787/callback
# Optional: set after list_my_leagues / list_my_teams return your keys.
YAHOO_LEAGUE_KEY=
YAHOO_TEAM_KEY=
# Local stdio is the default. HTTP binds only to loopback.
MCP_TRANSPORT=stdio
MCP_PORT=3000
# Required for HTTP, including demo HTTP. Generate a random secret locally.
MCP_BEARER_TOKEN=
